{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${K4_MISSIONS_VERSION}",
	"name": "k4_missions",
	"description": "K4-Missions: a dynamic mission system for Counter-Strike 2 (K4ryuu/K4-Missions-SwiftlyS2 v1.0.6, C#/.NET), ported to Plugify on native s2sdk. Missions are defined in missions.json with event-based progress (kills, assists, MVP, bomb plant/defuse, hostage rescue, round wins, playtime), event property filters (weapon, headshot, map, distance, ...), a minimum-player requirement and optional warmup protection. Assignment counts differ for VIP (the vip core) and normal players; missions reset daily/weekly/monthly/per-map/instantly; rewards are server commands with the original placeholders; Discord webhooks report completions and resets. Configuration: config.json, missions.json, discord/*.json and databases.cfg (section k4_missions, MySQL or SQLite; PostgreSQL is not supported).",
	"author": "K4ryuu, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/k4_missions",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=3.0.0"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		},
		{
			"name": "permissions",
			"constraints": ">=1.3.1",
			"optional": true
		}
	]
}
